# Chattist Environment Configuration

# Server Port (default: 3000)
PORT=3000

# JWT Secret Key (REQUIRED - Use a long, random string)
JWT_SECRET=your_super_secret_key_here

# CORS Origin (e.g., https://yourdomain.com)
# Leave empty or set to 'true' to allow all (not recommended for production)
CORS_ORIGIN=http://localhost:3000

# Node Environment (production or development)
NODE_ENV=development
